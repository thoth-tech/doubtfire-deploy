# Copy this file to .env.production, replace every REPLACE_ME value, and run
# ./validate.sh before deployment. Keep the completed file mode 0600 and never
# commit it.

# Compose and public endpoint
COMPOSE_PROJECT_NAME=doubtfire-production
SERVER_NAME=ontrack.REPLACE_ME.edu.au
DF_INSTITUTION_HOST=https://ontrack.REPLACE_ME.edu.au
TZ=Australia/Melbourne
# Total HTTP request limit, not the API per-file policy. At least 32m is needed
# for chat attachments plus multipart overhead; see UPLOAD-LIMITS.md.
CLIENT_MAX_BODY_SIZE=1g

# Immutable container references. Resolve and record the tested sha256 digest
# for every release; mutable tags such as latest or 11.0.x are rejected.
PROXY_IMAGE=nginx:1.30.4-alpine@sha256:REPLACE_ME
MARIADB_IMAGE=mariadb@sha256:REPLACE_ME
REDIS_IMAGE=redis@sha256:REPLACE_ME
DOCKER_SOCKET_PROXY_IMAGE=haproxy:3.2-alpine@sha256:REPLACE_ME
DOUBTFIRE_API_IMAGE=lmsdoubtfire/apiserver@sha256:REPLACE_ME
DOUBTFIRE_APP_IMAGE=lmsdoubtfire/appserver@sha256:REPLACE_ME
DOUBTFIRE_WEB_IMAGE=lmsdoubtfire/doubtfire-web@sha256:REPLACE_ME
TEXLIVE_IMAGE=lmsdoubtfire/formatif-latex@sha256:REPLACE_ME
JPLAG_IMAGE=lmsdoubtfire/doubtfire-jplag@sha256:REPLACE_ME

# Absolute host paths. Create every directory before deployment and include the
# database and complete student-work tree in the backup policy.
STUDENT_WORK_PATH=/srv/doubtfire/student-work
DOUBTFIRE_LOG_PATH=/srv/doubtfire/log
MARIADB_DATA_PATH=/srv/doubtfire/mariadb
REDIS_DATA_PATH=/srv/doubtfire/redis
JPLAG_REPORT_PATH=/srv/doubtfire/student-work/jplag
JPLAG_ARCHIVE_REPORT_PATH=/srv/doubtfire/student-work/archive/jplag
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/ontrack.REPLACE_ME.edu.au/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/ontrack.REPLACE_ME.edu.au/privkey.pem
ALIASES_PATH=/etc/doubtfire/aliases
MSMTPRC_PATH=/etc/doubtfire/msmtprc
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Database. Generate independent high-entropy passwords; do not reuse them.
MARIADB_DATABASE=doubtfire
MARIADB_USER=dfire
MARIADB_PASSWORD=REPLACE_ME_WITH_AT_LEAST_20_RANDOM_CHARACTERS
MARIADB_ROOT_PASSWORD=REPLACE_ME_WITH_AT_LEAST_20_RANDOM_CHARACTERS

# Rails signing and encryption keys. Existing deployments must retain their
# current values or encrypted data and sessions may become unreadable.
DF_SECRET_KEY_BASE=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DF_SECRET_KEY_ATTR=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DF_SECRET_KEY_DEVISE=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DF_SECRET_KEY_MOSS=
DF_ENCRYPTION_PRIMARY_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DF_ENCRYPTION_DETERMINISTIC_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DF_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Background job threads. Five is the maximum supported by the default Active
# Record connection pool; reduce only after measuring queue latency and load.
DF_SIDEKIQ_CONCURRENCY=5

# Peer Progress Indicator privacy and freshness policy for both the compact
# completion view and the advanced status distribution. The minimum applies to
# the remaining peer cohort after the authenticated student is excluded, and
# may be raised above 21. The maximum snapshot age may be reduced below 48
# hours. Never lower the cohort value to make a suppressed view appear.
DF_PPI_MINIMUM_COHORT_SIZE=21
DF_PPI_STALE_AFTER_HOURS=48

# Optional Teams announcement import. Existing OnTrack SSO is unchanged.
# See ../UNIT-HUB.md before enabling; requires university-approved Microsoft
# app consent and an explicit student-wide channel / approved publisher mapping.
# Keep secrets in the deployment secret store, never in a committed env file.
DF_TEAMS_ANNOUNCEMENTS_ENABLED=false
DF_TEAMS_CHANNEL_MAPPINGS=[]
DF_TEAMS_TENANT_ID=
DF_TEAMS_CLIENT_ID=
DF_TEAMS_CLIENT_SECRET=

# Web Push. Generate a production-only VAPID P-256 keypair; never reuse the
# checked-in development pair. The private key is a persistent production
# secret. The subject must be an operational mailto: or HTTPS contact.
DOUBTFIRE_VAPID_PUBLIC_KEY=REPLACE_ME_WITH_VAPID_PUBLIC_KEY
DOUBTFIRE_VAPID_PRIVATE_KEY=REPLACE_ME_WITH_VAPID_PRIVATE_KEY
DOUBTFIRE_VAPID_SUBJECT=mailto:ontrack-operations@REPLACE_ME.edu.au

# Institution
DF_INSTITUTION_PRODUCT_NAME=OnTrack
DF_INSTITUTION_SETTINGS_RB=no_institution_setting.rb
DF_INSTITUTION_EMAIL_DOMAIN=REPLACE_ME.edu.au
DF_INSTITUTION_EMAIL_SENDER=ontrack@REPLACE_ME.edu.au
DF_INSTITUTION_NAME=REPLACE_ME

# Authentication must use an external production identity provider. Valid
# values are aaf, saml, or ldap. Fill the matching section below.
DF_AUTH_METHOD=saml

# AAF
DF_AAF_ISSUER_URL=
DF_AAF_AUDIENCE_URL=
DF_AAF_CALLBACK_URL=
DF_AAF_IDENTITY_PROVIDER_URL=
DF_AAF_UNIQUE_URL=
DF_AAF_AUTH_SIGNOUT_URL=
DF_SECRET_KEY_AAF=

# SAML
DF_SAML_METADATA_URL=https://REPLACE_ME/saml/metadata
DF_SAML_CONSUMER_SERVICE_URL=https://ontrack.REPLACE_ME.edu.au/api/auth/jwt
DF_SAML_SP_ENTITY_ID=https://ontrack.REPLACE_ME.edu.au
DF_SAML_IDP_TARGET_URL=https://REPLACE_ME/saml2
DF_SAML_IDP_SAML_NAME_IDENTIFIER_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress

# LDAP
DF_LDAP_HOST=
DF_LDAP_PORT=
DF_LDAP_ATTRIBUTE=
DF_LDAP_BASE=
DF_LDAP_SSL=true
DF_LDAP_USE_ADMIN_TO_BIND=false
DF_LDAP_ADMIN_USER=
DF_LDAP_ADMIN_PWD=

# Resource ceilings for student-controlled document and similarity processing.
TEXLIVE_MEMORY_LIMIT=2g
TEXLIVE_CPU_LIMIT=2
TEXLIVE_PIDS_LIMIT=256
JPLAG_MEMORY_LIMIT=4g
JPLAG_CPU_LIMIT=2
JPLAG_PIDS_LIMIT=256

# Mail is required for production notifications.
DF_MAIL_PERFORM_DELIVERIES=yes
DF_MAIL_DELIVERY_METHOD=smtp
DF_SMTP_ADDRESS=smtp.REPLACE_ME.edu.au
DF_SMTP_PORT=587
DF_SMTP_DOMAIN=REPLACE_ME.edu.au
DF_SMTP_USERNAME=REPLACE_ME
DF_SMTP_PASSWORD=REPLACE_ME
DF_SMTP_AUTHENTICATION=plain

# Overseer is not supported by this single-host core stack. It requires a
# separate runner storage and image-management contract, so keep it disabled.
OVERSEER_ENABLED=0

# First-time tutorial rollout. 1 enables it; 0 keeps it off.
# Recreate apiserver after changing this; no web rebuild is required.
TUTORIAL_ENABLED=0
